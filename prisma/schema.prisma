generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ==================== AUTH ====================

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("FUNCIONARIO")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders           Order[]
  payments         Payment[]
  expenses         Expense[]
  cashRegisters    CashRegister[]
  closedRegisters  CashRegister[] @relation("ClosedBy")
  cashMovements    CashMovement[]
  inventoryMovements InventoryMovement[]
  manualCharges    ManualCharge[]
  auditLogs        AuditLog[]

  @@index([email])
  @@index([role])
}

// ==================== CUSTOMERS ====================

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  cpf       String?
  address   String?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([name])
  @@index([phone])
  @@index([cpf])
}

// ==================== PRODUCTS ====================

model Category {
  id    String  @id @default(cuid())
  name  String  @unique
  order Int     @default(0)
  active Boolean @default(true)

  products Product[]
}

model Product {
  id          String   @id @default(cuid())
  name        String
  categoryId  String?
  price       Int      @default(0)
  cost        Int      @default(0)
  stock       Int      @default(0)
  minStock    Int      @default(0)
  unit        String   @default("UN")
  code        String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category         Category?          @relation(fields: [categoryId], references: [id])
  orderItems       OrderItem[]
  inventoryMovements InventoryMovement[]

  @@index([categoryId])
  @@index([name])
  @@index([code])
}

// ==================== ORDERS (COMANDAS) ====================

model Order {
  id           String   @id @default(cuid())
  orderNumber  Int      @unique
  customerId   String?
  userId       String
  status       String   @default("ABERTA")
  subtotal     Int      @default(0)
  discount     Int      @default(0)
  addition     Int      @default(0)
  total        Int      @default(0)
  notes        String?
  createdAt    DateTime @default(now())
  closedAt     DateTime?
  updatedAt    DateTime @updatedAt

  customer     Customer?  @relation(fields: [customerId], references: [id])
  user         User       @relation(fields: [userId], references: [id])
  items        OrderItem[]
  manualCharges ManualCharge[]
  payments     Payment[]
  cashMovements CashMovement[]

  @@index([status])
  @@index([customerId])
  @@index([userId])
  @@index([createdAt])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String
  quantity  Int      @default(1)
  unitPrice Int      @default(0)
  costPrice Int      @default(0)
  total     Int      @default(0)
  createdAt DateTime @default(now())

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model ManualCharge {
  id          String   @id @default(cuid())
  orderId     String
  description String
  quantity    Int      @default(1)
  unitPrice   Int      @default(0)
  total       Int      @default(0)
  userId      String
  createdAt   DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@index([orderId])
}

// ==================== PAYMENTS ====================

model Payment {
  id        String   @id @default(cuid())
  orderId   String
  userId    String
  method    String
  amount    Int      @default(0)
  notes     String?
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@index([orderId])
  @@index([method])
  @@index([createdAt])
}

// ==================== EXPENSES ====================

model Expense {
  id            String   @id @default(cuid())
  description   String
  category      String
  amount        Int      @default(0)
  date          DateTime @default(now())
  paymentMethod String   @default("DINHEIRO")
  notes         String?
  userId        String
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([category])
  @@index([date])
}

// ==================== CASH REGISTER ====================

model CashRegister {
  id            String    @id @default(cuid())
  status        String    @default("ABERTO")
  initialValue  Int       @default(0)
  finalValue    Int?
  expectedValue Int?
  difference    Int?
  userId        String
  closedById    String?
  openedAt      DateTime  @default(now())
  closedAt      DateTime?

  user        User           @relation(fields: [userId], references: [id])
  closedBy    User?          @relation("ClosedBy", fields: [closedById], references: [id])
  movements   CashMovement[]

  @@index([status])
}

model CashMovement {
  id             String   @id @default(cuid())
  cashRegisterId String
  orderId        String?
  type           String
  amount         Int      @default(0)
  description    String?
  userId         String
  createdAt      DateTime @default(now())

  cashRegister CashRegister @relation(fields: [cashRegisterId], references: [id])
  order        Order?       @relation(fields: [orderId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@index([cashRegisterId])
  @@index([type])
}

// ==================== INVENTORY ====================

model InventoryMovement {
  id        String   @id @default(cuid())
  productId String
  type      String
  quantity  Int      @default(0)
  reference String?
  notes     String?
  userId    String
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([productId])
  @@index([type])
  @@index([createdAt])
}

// ==================== AUDIT ====================

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  details    String?
  ip         String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([resource])
  @@index([action])
  @@index([createdAt])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String?
  success   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([ip])
  @@index([createdAt])
}

// ==================== SETTINGS ====================

model SystemSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String

  @@index([key])
}
