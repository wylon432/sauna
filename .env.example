# Database - Use Turso for production (SQLite compatible)
# Sign up at https://turso.tech for free
# Then run: turso db create sauna-janice
# And get the URL: turso db show sauna-janice --url
# And token: turso db tokens create sauna-janice

# For local development (SQLite):
DATABASE_URL="file:./dev.db"

# For production (Turso):
# DATABASE_URL="libsql://your-db-name-your-org.turso.io"
# TURSO_AUTH_TOKEN="your-token-here"

# Auth
NEXTAUTH_SECRET="change-this-to-a-random-string-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Uploads
UPLOAD_DIR="./public/uploads"
MAX_FILE_SIZE=5242880
